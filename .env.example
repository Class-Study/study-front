# ─────────────────────────────────────────────────────────────────────────────
# EduSpace — Environment variables
# Copy this file to .env and fill in the required values.
# NEVER commit the .env file to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker image versions (leave empty for "latest") ─────────────────────────
FRONT_VERSION=
BACK_VERSION=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_NAME=eduspace
DB_USER=postgres
DB_PASSWORD=changeme_strong_password

# ── Redis ─────────────────────────────────────────────────────────────────────
# Leave empty to disable Redis authentication (not recommended for production)
REDIS_PASSWORD=changeme_redis_password

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=eduspace
RABBITMQ_PASSWORD=changeme_rabbitmq_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=changeme_jwt_secret_at_least_256_bits

# ── Frontend build (Docker build-arg) ────────────────────────────────────────
# Use a relative path so the SPA works behind any domain via Nginx.
# Override only when the API lives on a different origin (e.g. api.domain.com).
VITE_API_URL=/api/v1

# ── Development overrides (used only with `npm run dev` + Vite proxy) ────────
# The Vite dev server already proxies /api → http://localhost:8080.
# You only need to set VITE_WS_URL if the backend WS port differs from 8080.
# VITE_WS_URL=ws://localhost:8080
