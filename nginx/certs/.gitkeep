# Placeholder — TLS certificates are placed here at deploy time.
# Expected files (for Let's Encrypt / Certbot):
#   fullchain.pem   — certificate chain
#   privkey.pem     — private key
#
# Example (Certbot):
#   sudo certbot certonly --webroot -w /var/www/certbot -d yourdomain.com
#   sudo cp /etc/letsencrypt/live/yourdomain.com/fullchain.pem nginx/certs/
#   sudo cp /etc/letsencrypt/live/yourdomain.com/privkey.pem  nginx/certs/
#
# NEVER commit the actual certificate files to the repository.
